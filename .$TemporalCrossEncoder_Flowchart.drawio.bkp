        <mxCell id="n15" value="Get top_n elements&lt;br&gt;from reordered list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n16" value="Output: Reranked&lt;br&gt;documents list" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
