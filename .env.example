# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CTU SCHOLARSHIP CHATBOT
# ==========================================

# 1. LLM API KEYS (Bắt buộc)
# Google Gemini API Key (Dùng cho LLM sinh câu trả lời & Rewriter)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# LlamaCloud API Key (Dùng cho OCR / Parse tài liệu PDF tự động)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# (Tùy chọn) API Key dự phòng cho các LLM / Provider khác
GROQ_API_KEY=
ZHIPUAI_API_KEY=
OPENROUTER_API_KEY=

# 2. CƠ SỞ DỮ LIỆU & HẠ TẦNG (DOCKER SERVICES)
# PostgreSQL Connection (Lưu trữ lịch sử chat, user, văn bản parent)
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/ctu_chatbot

# Redis Connection (Quản lý session cache và chat buffer ngắn hạn)
REDIS_URL=redis://localhost:6379

# Qdrant Vector Database (Dense Vector search)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=ctu_scholarship_docs_current
QDRANT_TIMEOUT_SECONDS=60

# Neo4j Knowledge Graph (Truy vấn chương trình đào tạo & cấu trúc học phí)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# 3. BẢO MẬT & XÁC THỰC (AUTHENTICATION)
# Khóa bí mật dùng để mã hóa JWT Token (chuỗi ngẫu nhiên dài)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# 4. CẤU HÌNH RAG ENGINE, LOCAL EMBEDDING & LOCAL RERANKER
# Bật/Tắt bộ lọc Metadata doanh nghiệp (true/false)
RAG_METADATA_FILTER_ENABLED=true

# Embedding Model: Mô hình nhúng tiếng Việt cục bộ (768 chiều, tự động chạy CUDA/CPU)
# Mặc định nạp từ thư mục ./models/vietnamese-bi-encoder hoặc HuggingFace bkai-foundation-models/vietnamese-bi-encoder
RAG_EMBEDDING_MODEL=./models/vietnamese-bi-encoder

# Reranker Model: Mô hình Cross-Encoder cục bộ (tự động chạy CUDA/CPU kèm Temporal Tie-Break)
# Mặc định nạp từ thư mục ./models/bge-reranker-v2-m3 hoặc HuggingFace BAAI/bge-reranker-v2-m3
RAG_RERANKER_MODEL=./models/bge-reranker-v2-m3
